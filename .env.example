NODE_ENV=development
PORT=3000

# 建议通过 options 指定会话时区为中国时区（Asia/Shanghai）；若省略，Node 应用也会在连接串上自动附加，保证 Prisma 写入的 createdAt/updatedAt 与库内 CURRENT_TIMESTAMP 按中国时区解释
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/miniapp_db?schema=public&options=-c%20TimeZone%3DAsia%2FShanghai"

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

WECHAT_APPID="wxa2091918421e9f97"
WECHAT_SECRET="f2f3584195fc86303125530b42c8fae3"

# 逗号分隔，留空则开发环境默认允许任意来源（生产务必配置）
CORS_ORIGIN=http://localhost:5173

# 足/篮预测定时预热（启动时立即跑一次，之后按间隔重复）；设为 false 可关闭
# PREDICTION_SCHEDULE_ENABLED=true
# 定时预热间隔（毫秒），默认 21600000（6 小时）；最小 60000（1 分钟）
# PREDICTION_SCHEDULE_INTERVAL_MS=21600000

# Vector Engine OpenAI 兼容 API（定价与 GPT 系列：https://api.vectorengine.ai/pricing?keyword=gpt ）
VECTOR_ENGINE_API_KEY=
# 默认已指向官方网关；一般无需改
# VECTOR_ENGINE_BASE_URL=https://api.vectorengine.ai/v1
# 通用 AI 接口（prompt/chat/travel-guide 等）默认模型
# VECTOR_ENGINE_MODEL=gpt-5.4-nano
# 足球/篮球预测专用；请求体未传 model 时使用（默认 gpt-5.4）
# PREDICTION_VECTOR_ENGINE_MODEL=gpt-5.4
# 预测预热：单次 chat 超时（毫秒），默认 900000（15 分钟）；赛程 JSON 很大时过短易报 fetch failed
# PREDICTION_VECTOR_ENGINE_TIMEOUT_MS=900000
# 预测预热：fetch 瞬时失败时的最大尝试次数（默认 3）
# PREDICTION_VECTOR_ENGINE_FETCH_RETRIES=3
# 旅游攻略专用；请求体未传 model 时使用（默认 qwen3.5-plus；定价页见 https://api.vectorengine.ai/pricing?keyword=Qwen3.5-Plus ）
# TRAVEL_GUIDE_VECTOR_ENGINE_MODEL=qwen3.5-plus

# 小红书图生文 POST /api/ai/xhs-grass-from-image；默认豆包多模态（与控制台模型 ID 一致）
# XHS_GRASS_VECTOR_ENGINE_MODEL=doubao-seed-1-6-flash-250828
# 单次上游超时（毫秒），默认 120000；最小 30000
# XHS_GRASS_VECTOR_ENGINE_TIMEOUT_MS=120000

# 电商 Seedream：阶段一 POST /api/ai/ecommerce/seedream/analyze；阶段二 POST /api/ai/ecommerce/seedream/generate（连字符路径仍为别名）
# ECOMMERCE_VISUAL_ANALYST_MODEL=doubao-seed-1-6-flash-250828
# ECOMMERCE_VISUAL_ANALYST_TIMEOUT_MS=120000
# SEEDREAM_5_VECTOR_ENGINE_MODEL=doubao-seedream-5-0-260128
# SEEDREAM_5_VECTOR_ENGINE_TIMEOUT_MS=300000
# 为 false 时出图请求体使用单图字段 image（data URL）；默认（未配置或 true）只带 images: [dataUrl]
# SEEDREAM5_REFERENCE_AS_IMAGES_ARRAY_ONLY=false

# 和风天气 v7 实时天气（GET /api/weather/now）；凭据见 https://console.qweather.com/project
QWEATHER_API_KEY=
# 控制台「API Host」专属域名（必填），可写 https://xxx.qweatherapi.com 或仅域名
QWEATHER_API_HOST=
